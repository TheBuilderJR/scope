{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scope",
  "version": "0.1.0",
  "identifier": "com.bobrenjc93.scope",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Scope",
        "label": "main",
        "center": true,
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 540,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "File browser + system monitor",
    "longDescription": "Scope combines a Finder-style file browser with an Activity-Monitor / htop-style live system monitor in a single GUI.",
    "macOS": {
      "signingIdentity": "Developer ID Application: KaoRen, LLC (3C55KB6N72)"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
